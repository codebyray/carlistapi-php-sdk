{
  "name": "codebyray/carlistapi-php-sdk",
  "description": "Framework-agnostic PHP SDK for the Car List API automotive, powersports, and VIN decoder endpoints.",
  "keywords": [
    "php",
    "vehicle",
    "automotive",
    "powersports",
    "vin",
    "api",
    "sdk"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.8",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "CodebyRay\\CarListApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodebyRay\\CarListApi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
